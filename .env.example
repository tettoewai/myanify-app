EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# Spotify login (PKCE public client). Must match web SPOTIFY_CLIENT_ID.
# Register redirect `myanify://auth/spotify` in the Spotify dashboard.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
# Ed25519 manifest verification (public). Get from web: pnpm gen:release-keys
EXPO_PUBLIC_RELEASE_PUBLIC_KEY=
EXPO_PUBLIC_RELEASE_REPO=tettoewai/myanify-releases
