{
  "expo": {
    "name": "Myanify",
    "slug": "myanify-app",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myanify",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tlab.myanify",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.739457800060-s319n61if27pmd7lhffoqhatpi2k7asb"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 19,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tlab.myanify"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-updates",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.739457800060-s319n61if27pmd7lhffoqhatpi2k7asb"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1c232487-7c69-437f-a31a-8a8cd9bce061",
      "channel": "production",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c232487-7c69-437f-a31a-8a8cd9bce061"
      },
      "google": {
        "androidClientId": "739457800060-e53a1s0m3576udu1o5id670plh18aab7.apps.googleusercontent.com",
        "iosClientId": "739457800060-s319n61if27pmd7lhffoqhatpi2k7asb.apps.googleusercontent.com",
        "webClientId": "739457800060-eq2ieghufl3vmdr96se7tofi9h67gr6i.apps.googleusercontent.com"
      }
    }
  }
}
