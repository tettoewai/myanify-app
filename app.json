{
  "expo": {
    "name": "Myanify",
    "slug": "myanify-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myanify",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tlab.myanify",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.739457800060-s319n61if27pmd7lhffoqhatpi2k7asb"
            ]
          }
        ]
      },
      "plugins": [
        [
          "@react-native-google-signin/google-signin",
          {
            "iosUrlScheme": "com.googleusercontent.apps.739457800060-s319n61if27pmd7lhffoqhatpi2k7asb"
          }
        ]
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tlab.myanify"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c232487-7c69-437f-a31a-8a8cd9bce061"
      },
      "google": {
        "androidClientId": "739457800060-e53a1s0m3576udu1o5id670plh18aab7.apps.googleusercontent.com",
        "iosClientId": "739457800060-s319n61if27pmd7lhffoqhatpi2k7asb.apps.googleusercontent.com",
        "webClientId": "739457800060-eq2ieghufl3vmdr96se7tofi9h67gr6i.apps.googleusercontent.com"
      }
    }
  }
}
